datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WorkType {
  id        String    @id @default(uuid())
  title     String    @unique
  unit      String
  workLogs  WorkLog[]
}

model WorkLog {
  id           String   @id @default(uuid())
  date         DateTime
  workTypeId   String
  workType     WorkType @relation(fields: [workTypeId], references: [id])
  volume       Float
  executorName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
